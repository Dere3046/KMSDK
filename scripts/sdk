#!/bin/sh
# KMSDK package manager
# usage: sdk <add|remove|update|ls|audit|install>
set -e

SDKDIR=$(cd "$(dirname "$0")/.." && pwd)
REGLIST=$SDKDIR/libs.lst

cmd=$1
shift || true

reg_rev() {
	awk -v n="$1" '$1==n {print $3; exit}' "$REGLIST"
}

reg_url() {
	awk -v n="$1" '$1==n {print $2; exit}' "$REGLIST"
}

head_rev() {
	git ls-remote "$1" HEAD 2>/dev/null | awk '{print $1}'
}

case $cmd in
ls)
	awk '!/^#/ {d=$4; for(i=5;i<=NF;i++) d=d" "$i; printf "%-14s %s\n", $1, d}' "$REGLIST"
	;;
add)
	name=$1
	rev=$2
	[ -n "$name" ] || { echo "usage: sdk add <name> [rev]"; exit 1; }
	[ -z "$rev" ] && rev=$(reg_rev "$name")
	[ -z "$rev" ] && { echo "unknown lib: $name"; exit 1; }
	if grep -q "^$name " deps.lst; then
		echo "already in deps.lst"
	else
		echo "$name $rev" >> deps.lst
		echo "added $name $rev"
	fi
	;;
remove)
	name=$1
	[ -n "$name" ] || { echo "usage: sdk remove <name>"; exit 1; }
	if grep -q "^$name " deps.lst; then
		sed -i "/^$name /d" deps.lst
		echo "removed $name from deps.lst"
	else
		echo "not in deps.lst"
	fi
	if [ -d "deps/$name" ]; then
		rm -rf "deps/$name"
		echo "removed deps/$name"
	fi
	;;
update)
	name=$1
	rev=$2
	[ -n "$name" ] || { echo "usage: sdk update <name> [rev|latest]"; exit 1; }
	if [ "$rev" = "latest" ]; then
		url=$(reg_url "$name")
		[ -z "$url" ] && { echo "unknown lib: $name"; exit 1; }
		rev=$(head_rev "$url")
		[ -z "$rev" ] && { echo "cannot resolve latest for $name"; exit 1; }
	elif [ -z "$rev" ]; then
		rev=$(reg_rev "$name")
	fi
	[ -z "$rev" ] && { echo "unknown lib: $name"; exit 1; }
	if grep -q "^$name " deps.lst; then
		sed -i "s/^$name .*/$name $rev/" deps.lst
		echo "updated $name -> $rev"
	else
		echo "not in deps.lst, use sdk add"
	fi
	;;
audit)
	find_owner() {
		h=$1
		for f in deps/*/deps.mk; do
			[ -f "$f" ] || continue
			id=$(sed -n 's/^DEPS_LIB_NAME := \(.*\)$/\1/p' "$f")
			[ -z "$id" ] && continue
			dir=${f%deps.mk}
			for d in $(sed -n 's/^DEPS_LIB_INCS := \(.*\)$/\1/p' "$f"); do
				if [ -f "$dir/$d/$h" ]; then
					echo "$id"
					return 0
				fi
			done
		done
		return 1
	}
	if ! ls deps/*/deps.mk >/dev/null 2>&1; then
		echo "run sdk install first, no vendored deps yet"
		exit 1
	fi
	refs=$(grep -rhoE '#include "[^"]+\.h"' src lib 2>/dev/null \
		| sed 's/#include "//;s/"//' | sort -u)
	missing=0
	for h in $refs; do
		lib=$(find_owner "$h")
		[ -z "$lib" ] && continue
		if ! grep -q "^$lib " deps.lst; then
			echo "referenced but missing: $lib (sdk add $lib)"
			missing=1
		fi
	done
	[ "$missing" = 0 ] && echo "no missing deps"
	;;
latest)
	name=$1
	[ -n "$name" ] || { echo "usage: sdk latest <name>"; exit 1; }
	url=$(reg_url "$name")
	[ -z "$url" ] && { echo "unknown lib: $name"; exit 1; }
	rev=$(head_rev "$url")
	[ -z "$rev" ] && { echo "cannot resolve latest for $name"; exit 1; }
	echo "$rev"
	;;
self)
	url=$(git -C "$SDKDIR" remote get-url origin 2>/dev/null)
	[ -z "$url" ] && { echo "no origin for the sdk repo"; exit 1; }
	rev=$(head_rev "$url")
	[ -z "$rev" ] && { echo "cannot resolve sdk latest"; exit 1; }
	echo "$rev" > .sdk-version
	git -C "$SDKDIR" fetch origin 2>/dev/null || true
	git -C "$SDKDIR" checkout "$rev" >/dev/null 2>&1 || true
	echo "sdk pinned to $rev"
	;;
install)
	exec "$SDKDIR/scripts/deploy-deps.sh" "$(pwd)"
	;;
*)
	echo "usage: sdk <add|remove|update|latest|self|ls|audit|install>"
	exit 1
	;;
esac
